# tajné – nikdy necommitovat
**/.env
**/accounts.json

# Node / Capacitor / iOS build (generuje se v CI nebo na Macu)
app/node_modules/
app/ios/
app/build/
**/Pods/
**/DerivedData/

# Python
__pycache__/
*.pyc

# dočasné
*.wav
*.log

# velká regenerovatelná média z NotebookLM (nejsou potřeba pro hru ani appku;
# lze kdykoli znovu vygenerovat). Když je chceš v repu, smaž tyto řádky.
deti-2trida/*.mp3
dospeli/*.mp3
deti-2trida/PREZENTACE-orientacni-beh.pdf
dospeli/prezentace.pdf

# audio se hostuje na vlastním serveru, ne na GitHubu
zdroje/tts/audio/

# push token serveru – nikdy do gitu
server/ota-token.txt

# číslo buildu doplní CI
app/www/version.json

# specifikace IOF/ČSOS (ISCD) – velká PDF, stáhnout z orienteering.sport a ceskyorientak.cz;
# hra používá jen vytažené piktogramy v zdroje/iscd_piktogramy.json
zdroje/ISCD-*.pdf
